diff --git a/gcc/testsuite/gcc.target/m68k/near-1.c b/gcc/testsuite/gcc.target/m68k/near-1.c
new file mode 100644
index 00000000000..5d95766590b
--- /dev/null
+++ b/gcc/testsuite/gcc.target/m68k/near-1.c
@@ -0,0 +1,62 @@
+/* { dg-do compile } */
+/* { dg-options "-O2 -m68000" } */
+/* Near variables are addressed with (xxx).w and land in .sbss/.sdata.  */
+
+extern short frame __attribute__ ((near));
+short frame __attribute__ ((near));
+short table[8] __attribute__ ((near));
+int init __attribute__ ((near)) = 3;
+extern int far;
+
+short
+load (void)
+{
+  return frame;
+}
+
+void
+store (short v)
+{
+  frame = v;
+}
+
+short
+elt (void)
+{
+  return table[3];
+}
+
+int
+mixed (void)
+{
+  return far + init;
+}
+
+short *
+addr (void)
+{
+  return table;
+}
+
+void
+touch (void)
+{
+  table[0]++;
+}
+
+short
+elt_at (int i)
+{
+  return table[i];
+}
+
+/* { dg-final { scan-assembler "\\(frame\\)\\.w" } } */
+/* { dg-final { scan-assembler "\\(table\\+6\\)\\.w" } } */
+/* { dg-final { scan-assembler "\\(init\\)\\.w" } } */
+/* { dg-final { scan-assembler-not "\\(far\\)\\.w" } } */
+/* { dg-final { scan-assembler "\\.section\\s+\\.sbss" } } */
+/* { dg-final { scan-assembler "\\.section\\s+\\.sdata" } } */
+/* { dg-final { scan-assembler "addq\\.w #1,\\(table\\)\\.w" } } */
+/* { dg-final { scan-assembler "#table" } } */
+/* Indexed: the near symbol is the (d16,An) displacement.  */
+/* { dg-final { scan-assembler "table\\(%a\[0-7\]\\)" } } */
