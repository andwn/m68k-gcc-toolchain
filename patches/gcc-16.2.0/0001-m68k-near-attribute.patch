+/* Handle a "near" attribute.  Only static storage is supported, and
+   the short absolute form does not exist in position-independent code.  */
+
+static tree
+m68k_handle_near_attribute (tree *node, tree name,
+			    tree args ATTRIBUTE_UNUSED,
+			    int flags ATTRIBUTE_UNUSED,
+			    bool *no_add_attrs)
+{
+  if (!VAR_P (*node))
+    {
+      warning (OPT_Wattributes, "%qE attribute only applies to variables",
+	       name);
+      *no_add_attrs = true;
+    }
+  else if (!TREE_STATIC (*node) && !DECL_EXTERNAL (*node))
+    {
+      warning (OPT_Wattributes, "%qE attribute ignored for automatic "
+	       "variable %qD", name, *node);
+      *no_add_attrs = true;
+    }
+  else if (flag_pic)
+    {
+      warning (OPT_Wattributes, "%qE attribute ignored for %qD in "
+	       "position-independent code", name, *node);
+      *no_add_attrs = true;
+    }
+
+  return NULL_TREE;
+}
+
+/* Return true if DECL is a near-data variable.  */
+
+static bool
+m68k_near_p (const_tree decl)
+{
+  return (VAR_P (decl)
+	  && lookup_attribute ("near", DECL_ATTRIBUTES (decl)) != NULL_TREE);
+}
+
+/* Implement TARGET_IN_SMALL_DATA_P: near variables go to .sdata/.sbss,
+   and default_encode_section_info marks their symbols SYMBOL_FLAG_SMALL.  */
+
+static bool
+m68k_in_small_data_p (const_tree decl)
+{
+  return m68k_near_p (decl);
+}
+
+/* Implement TARGET_ENCODE_SECTION_INFO.  Keep near variables out of
+   common storage so the linker places them in a near-data section.  */
+
+static void
+m68k_encode_section_info (tree decl, rtx rtl, int first)
+{
+  if (first && m68k_near_p (decl))
+    DECL_COMMON (decl) = 0;
+  default_encode_section_info (decl, rtl, first);
+}
+
+/* Output uninitialized variables.  Near ones get a label in .sbss;
+   everything else keeps the stock .bss / .local output.  LOCAL_P selects
+   the local fallback.  */
+
+void
+m68k_output_aligned_bss (FILE *file, tree decl, const char *name,
+			 unsigned HOST_WIDE_INT size, int align, bool local_p)
+{
+  if (local_p && !(decl && m68k_near_p (decl)))
+    {
+#ifdef ASM_OUTPUT_ALIGNED_LOCAL
+      ASM_OUTPUT_ALIGNED_LOCAL (file, name, size, align);
+#else
+      ASM_OUTPUT_LOCAL (file, name, size, size);
+#endif
+      return;
+    }
+
+  if (decl && m68k_near_p (decl))
+    switch_to_section (get_named_section (decl, ".sbss", 0));
+  else
+    switch_to_section (bss_section);
+  ASM_OUTPUT_ALIGN (file, floor_log2 (align / BITS_PER_UNIT));
+  last_assemble_variable_decl = decl;
+  ASM_DECLARE_OBJECT_NAME (file, name, decl);
+  ASM_OUTPUT_SKIP (file, size ? size : 1);
+}
+
+/* Return true if X is a 16-bit constant address or a (possibly offset)
+   near-data symbol, i.e. reachable with (xxx).w.  */
+
+static bool
+m68k_short_address_p (rtx x)
+{
+  if (CONST_INT_P (x))
+    return IN_RANGE (INTVAL (x), -0x8000, 0x7fff);
+
+  if (flag_pic)
+    return false;
+
+  rtx base, offset;
+  split_const (x, &base, &offset);
+  return SYMBOL_REF_P (base) && SYMBOL_REF_SMALL_P (base);
+}
