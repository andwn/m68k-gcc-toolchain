diff --git a/gcc/testsuite/gcc.target/m68k/near-run-1.c b/gcc/testsuite/gcc.target/m68k/near-run-1.c
new file mode 100644
index 00000000000..a9ea67279f8
--- /dev/null
+++ b/gcc/testsuite/gcc.target/m68k/near-run-1.c
@@ -0,0 +1,49 @@
+/* { dg-do run } */
+/* { dg-options "-m68000 -O2 -Wl,--section-start=.sbss=0xffff8000" } */
+
+extern void abort (void);
+
+short frame __attribute__ ((near));
+short table[8] __attribute__ ((near));
+int wide __attribute__ ((near));
+struct { char a; short b; } pair __attribute__ ((near));
+
+__attribute__ ((noipa)) void
+tick (void)
+{
+  frame++;
+  table[frame & 7] += frame;
+  wide -= 3;
+  pair.a = (char) frame;
+  pair.b = (short) -frame;
+}
+
+__attribute__ ((noipa)) short *
+slot (int i)
+{
+  return &table[i];
+}
+
+int
+main (void)
+{
+  int i;
+  volatile unsigned long p = (unsigned long) &frame;
+
+  if ((p & 0xffff8000ul) != 0xffff8000ul)
+    abort ();
+
+  for (i = 0; i < 20; i++)
+    tick ();
+
+  if (frame != 20 || wide != -60 || pair.a != 20 || pair.b != -20)
+    abort ();
+  /* frame values 1..20 into table[frame & 7]:
+     slot 0: 8+16=24, slot 1: 1+9+17=27, 2: 2+10+18=30, 3: 3+11+19=33,
+     4: 4+12+20=36, 5: 5+13=18, 6: 6+14=20, 7: 7+15=22.  */
+  if (table[0] != 24 || table[1] != 27 || table[4] != 36 || table[7] != 22)
+    abort ();
+  if (*slot (5) != 18 || slot (3) != table + 3)
+    abort ();
+  return 0;
+}
