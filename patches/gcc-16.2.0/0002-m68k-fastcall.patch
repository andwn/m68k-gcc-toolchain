+/* { dg-options "-m68000 -mfastcall -O2" } */
+
+/* A cdecl function under -mfastcall treats d2 as callee-saved.  */
+
+extern void touch (long *);
+long sink[4];
+
+long __attribute__((cdecl))
+callee (long a, long b, long c)
+{
+  long x = a * 3, y = b * 5, z = c * 7;
+  touch (&sink[0]);
+  sink[1] = x; sink[2] = y; sink[3] = z;
