+/* Diagnose mutually exclusive calling-convention attributes.  */
+
+static void
+m68k_validate_mutually_exclusive_attribute (const char *attr1,
+					    const char *attr2, tree *node)
+{
+  if (lookup_attribute (attr2, TYPE_ATTRIBUTES (*node)))
+    error ("%qs and %qs attributes are mutually exclusive", attr1, attr2);
+}
+
+/* Handle a calling-convention type attribute.  */
+
+static tree
+m68k_handle_type_attribute (tree *node, tree name, tree args ATTRIBUTE_UNUSED,
+			    int flags ATTRIBUTE_UNUSED, bool *no_add_attrs)
+{
+  if (TREE_CODE (*node) == FUNCTION_TYPE
+      || TREE_CODE (*node) == METHOD_TYPE
+      || TREE_CODE (*node) == FIELD_DECL
+      || TREE_CODE (*node) == TYPE_DECL)
+    {
+      if (is_attribute_p ("cdecl", name))
+	m68k_validate_mutually_exclusive_attribute ("cdecl", "fastcall",
+						       node);
+      else if (is_attribute_p ("fastcall", name))
+	m68k_validate_mutually_exclusive_attribute ("fastcall", "cdecl",
+						       node);
+    }
+  else
+    {
+      warning (OPT_Wattributes, "%qE attribute only applies to functions",
+	       name);
+      *no_add_attrs = true;
+    }
+
+  return NULL_TREE;
+}
+
+static int
+m68k_comp_type_attributes (const_tree type1, const_tree type2)
+{
+  /* Functions or methods are incompatible if they specify mutually
+     exclusive ways of passing arguments.  */
+  if (TREE_CODE (type1) == FUNCTION_TYPE
+      || TREE_CODE (type1) == METHOD_TYPE)
+    {
+      bool type1_cdecl_p
+	= lookup_attribute ("cdecl", TYPE_ATTRIBUTES (type1));
+      bool type2_cdecl_p
+	= lookup_attribute ("cdecl", TYPE_ATTRIBUTES (type2));
+      bool type1_fastcall_p
+	= lookup_attribute ("fastcall", TYPE_ATTRIBUTES (type1));
+      bool type2_fastcall_p
+	= lookup_attribute ("fastcall", TYPE_ATTRIBUTES (type2));
+
+      if (type1_cdecl_p != type2_cdecl_p
+	  || type1_fastcall_p != type2_fastcall_p)
+	return 0;
+    }
+  return 1;
+}
+
+
+/* Set the calling ABI for FNDECL.  */
+void
+m68k_call_abi_override (const_tree fndecl)
+{
+  if (fndecl == NULL_TREE)
+    cfun->machine->call_abi = m68k_abi;
+  else
+    cfun->machine->call_abi = m68k_function_type_abi (TREE_TYPE (fndecl));
+}
+
+static enum calling_abi
+m68k_function_abi (const_tree fndecl)
+{
+  if (!fndecl)
+    return m68k_abi;
+  return m68k_function_type_abi (TREE_TYPE (fndecl));
+}
+
+/* Return the ABI of the current function.  */
+enum calling_abi
+m68k_cfun_abi (void)
+{
+  if (!cfun)
+    return m68k_abi;
+  return cfun->machine->call_abi;
+}
+
+/* Return the ABI specified by FNTYPE.  */
+enum calling_abi
+m68k_function_type_abi (const_tree fntype)
+{
+  if (fntype != NULL)
+    {
+      enum calling_abi abi = m68k_abi;
+      if (abi == std_abi)
+	{
+	  if (lookup_attribute ("fastcall", TYPE_ATTRIBUTES (fntype)))
+	    abi = fastcall_abi;
+	}
+      else if (lookup_attribute ("cdecl", TYPE_ATTRIBUTES (fntype)))
+	abi = std_abi;
+      return abi;
+    }
+  return m68k_abi;
+}
+
+/* Reinitialize register usage after an ABI switch.  */
+static void
+m68k_maybe_switch_abi (void)
+{
+  if (call_used_regs[D2_REG] == (cfun->machine->call_abi == std_abi))
+    reinit_regs ();
+}
+
+/* Initialize CUM for a call to FNTYPE or FNDECL.  LIBNAME is nonnull for
+   libcalls.  */
+
+void
+m68k_init_cumulative_args (CUMULATIVE_ARGS *cum, tree fntype, rtx libname,
+			   tree fndecl, int ATTRIBUTE_UNUSED)
+{
+  cum->last_arg_reg = -1;
+  cum->last_arg_len = 0;
+  CLEAR_HARD_REG_SET (cum->regs_already_used);
+
+  if (libname)
+    /* Libcalls use the standard ABI.  */
+    cum->call_abi = std_abi;
+  else if (fndecl)
+    cum->call_abi = m68k_function_abi (fndecl);
+  else
+    cum->call_abi = m68k_function_type_abi (fntype);
+
+#if ! defined (PCC_STATIC_STRUCT_RETURN) && defined (M68K_STRUCT_VALUE_REGNUM)
+  /* If return value is a structure, and we pass the buffer address in a
+     register, we can't use this register for our own purposes.  */
+  if (fntype && aggregate_value_p (TREE_TYPE (fntype), fntype))
+    SET_HARD_REG_BIT (cum->regs_already_used, M68K_STRUCT_VALUE_REGNUM);
+#endif
+}
+
+/* Return the register for ARG, or NULL_RTX to pass it on the stack.  */
+
+static rtx
+m68k_function_arg (cumulative_args_t cum_v,
+		   const function_arg_info &arg)
+{
+  CUMULATIVE_ARGS *cum = get_cumulative_args (cum_v);
+
+  if (cum->call_abi == fastcall_abi)
+    {
+      int regbegin = -1, regend, len;
+      machine_mode mode = arg.mode;
+
+      if (!TARGET_68881
+	  && FLOAT_MODE_P (mode)
+	  && GET_MODE_UNIT_SIZE (mode) <= 4
+	  && (GET_MODE_CLASS (mode) != MODE_COMPLEX_FLOAT || mode == SCmode))
+	{
+	  regbegin = D0_REG;
+	  regend = regbegin + M68K_FASTCALL_DATA_PARM;
+	  len = ((GET_MODE_SIZE (mode) + UNITS_PER_WORD - 1)
+		 / UNITS_PER_WORD);
+	}
+      else if (TARGET_68881
+	       && FLOAT_MODE_P (mode)
+	       && GET_MODE_UNIT_SIZE (mode) <= 12
+	       && (GET_MODE_CLASS (mode) != MODE_COMPLEX_FLOAT
+		   || mode == SCmode))
+	{
+	  regbegin = FP0_REG;
+	  regend = regbegin + M68K_FASTCALL_DATA_PARM;
+	  len = GET_MODE_NUNITS (mode);
+	}
+      else if (INTEGRAL_MODE_P (mode) && mode != CQImode && mode != CHImode)
+	{
+	  len = ((GET_MODE_SIZE (mode) + UNITS_PER_WORD - 1)
+		 / UNITS_PER_WORD);
+	  if (len == 1)
+	    {
+	      const_tree type = arg.type;
+	      if (type && POINTER_TYPE_P (type))
+		{
+		  regbegin = A0_REG;
+		  regend = regbegin + M68K_FASTCALL_ADDR_PARM;
+		}
+	      else
+		{
+		  regbegin = D0_REG;
+		  regend = regbegin + M68K_FASTCALL_DATA_PARM;
+		}
+	    }
+	}
+
+      if (regbegin != -1)
+	{
+	  int reg;
+	  for (reg = regbegin; reg < regend; reg++)
+	    {
+	      if (!TEST_HARD_REG_BIT (cum->regs_already_used, reg)
+		  && reg + len <= regend)
+		{
+		  cum->last_arg_reg = reg;
+		  cum->last_arg_len = len;
+		  break;
+		}
+	    }
+	}
+
+      if (!arg.named)
+	SET_HARD_REG_SET (cum->regs_already_used);
+
+      if (cum->last_arg_reg != -1)
+	{
+	  return gen_rtx_REG (mode, cum->last_arg_reg);
+	}
+    }
+  return NULL_RTX;
+}
