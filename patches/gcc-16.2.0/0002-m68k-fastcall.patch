+/* { dg-do compile } */
+/* { dg-options "-m68000 -mfastcall -O2" } */
+
+/* Fastcall argument placement: scalar arguments in d0-d2, pointer
+   arguments in a0-a1, overflow on the stack.  */
+
+extern long gfast (long, long, long) __attribute__((fastcall));
+
+long
+call3 (void)
+{
+  return gfast (11, 22, 33);
+}
+
+long __attribute__((fastcall, noipa))
+load2 (long *p, long *q)
+{
+  return *p + *q;
+}
+
+long __attribute__((fastcall, noipa))
+mix (long a, long *p, long b, short c)
+{
+  return a + *p + b + c;
+}
+
+long __attribute__((fastcall, noipa))
+f4 (long a, long b, long c, long d)
+{
+  return a + b + c + d;
+}
