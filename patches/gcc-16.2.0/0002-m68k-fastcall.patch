+
+/* d2 is call-clobbered under -mfastcall.  */
+
+extern long g1 (long) __attribute__((fastcall));
+
+long __attribute__((fastcall, noipa))
+keep (long x)
+{
+  return g1 (x) + x;
+}
+
+/* { dg-final { scan-assembler-not {%d2} } } */
diff --git a/gcc/testsuite/gcc.target/m68k/fastcall-libcall-run.c b/gcc/testsuite/gcc.target/m68k/fastcall-libcall-run.c
new file mode 100644
index 00000000000..33d32c21c1a
--- /dev/null
+++ b/gcc/testsuite/gcc.target/m68k/fastcall-libcall-run.c
@@ -0,0 +1,61 @@
+/* { dg-do run } */
+/* { dg-options "-m68000 -mfastcall -O2" } */
+
+/* Libcalls made from fastcall functions must use the standard ABI and
+   produce correct values (the -mfastcall garbage-libcall-args fix).  */
+
+extern void abort (void);
+
+long __attribute__((fastcall, noipa))
+div_s (long a, long b)
+{
+  return a / b;
+}
+
+long __attribute__((fastcall, noipa))
+mod_s (long a, long b)
+{
+  return a % b;
+}
+
+unsigned long __attribute__((fastcall, noipa))
+divmod_u (unsigned long a, unsigned long b)
+{
+  return a / b + a % b;
+}
+
+long __attribute__((fastcall, noipa))
+mul32 (long a, long b)
+{
+  return a * b;
+}
+
+float __attribute__((fastcall, noipa))
+mac_f (float a, float b, float c)
+{
+  return a * b + c;
+}
+
+long __attribute__((fastcall, noipa))
+roundtrip_f (long a, long b)
+{
+  return (long) ((float) a / (float) b);
+}
+
+int __attribute__((cdecl))
+main (void)
+{
+  if (div_s (100, 7) != 14 || div_s (-100, 7) != -14)
+    abort ();
+  if (mod_s (100, 7) != 2 || mod_s (-100, 7) != -2)
+    abort ();
+  if (divmod_u (0x80000001UL, 10) != 214748364UL + 9)
+    abort ();
+  if (mul32 (51001L, 40009L) != 51001L * 40009L)
+    abort ();
+  if (mac_f (2.5f, 4.0f, 0.5f) != 10.5f)
+    abort ();
+  if (roundtrip_f (255, 4) != 63)
+    abort ();
+  return 0;
+}
diff --git a/gcc/testsuite/gcc.target/m68k/fastcall-libcall.c b/gcc/testsuite/gcc.target/m68k/fastcall-libcall.c
new file mode 100644
index 00000000000..f930a971d91
--- /dev/null
+++ b/gcc/testsuite/gcc.target/m68k/fastcall-libcall.c
@@ -0,0 +1,35 @@
+/* { dg-do compile } */
+/* { dg-options "-m68000 -mfastcall -O2" } */
+
+/* Libcalls use the standard ABI under -mfastcall: even though each
+   function below receives its operands in d0/d1, the libgcc call site
+   must push them on the stack (libgcc is compiled cdecl).  */
+
+long __attribute__((noipa))
+div_s (long a, long b)
+{
+  return a / b;
+}
+
+unsigned long __attribute__((noipa))
+mod_u (unsigned long a, unsigned long b)
+{
+  return a % b;
+}
+
+long __attribute__((noipa))
+mul32 (long a, long b)
+{
+  return a * b;
+}
+
+float __attribute__((noipa))
+addf (float a, float b)
+{
+  return a + b;
+}
+
+/* { dg-final { scan-assembler {move\.l %d1,-\(%sp\)\n\tmove\.l %d0,-\(%sp\)\n\tjsr __divsi3} } } */
+/* { dg-final { scan-assembler {move\.l %d1,-\(%sp\)\n\tmove\.l %d0,-\(%sp\)\n\tjsr __umodsi3} } } */
+/* { dg-final { scan-assembler {move\.l %d1,-\(%sp\)\n\tmove\.l %d0,-\(%sp\)\n\tjsr __mulsi3} } } */
+/* { dg-final { scan-assembler {move\.l %d1,-\(%sp\)\n\tmove\.l %d0,-\(%sp\)\n\tjsr __addsf3} } } */
diff --git a/gcc/testsuite/gcc.target/m68k/fastcall-sibcall-run.c b/gcc/testsuite/gcc.target/m68k/fastcall-sibcall-run.c
new file mode 100644
index 00000000000..c8e533debc6
--- /dev/null
+++ b/gcc/testsuite/gcc.target/m68k/fastcall-sibcall-run.c
@@ -0,0 +1,43 @@
+/* { dg-do run } */
+/* { dg-options "-m68000 -mfastcall -O2" } */
+
+/* Fastcall sibcalls compute the right values: a direct fastcall->fastcall
+   sibcall chain, and an indirect fastcall call.  */
+
+extern void abort (void);
+
+long __attribute__((fastcall, noipa))
+leaf (long a, long b, long c)
+{
+  return a * 2 + b * 3 + c * 5;
+}
+
+/* Direct sibcall, with the arguments rotated so the d0-d2 shuffle in the
+   sibcall frame actually has to do something.  */
+long __attribute__((fastcall, noipa))
+sib (long a, long b, long c)
+{
+  return leaf (b, c, a);
+}
+
+typedef long (*fastfn) (long, long, long) __attribute__((fastcall));
+
+long __attribute__((fastcall, noipa))
+calli (fastfn f, long a)
+{
+  return f (a, a + 1, a + 2);
+}
+
+int __attribute__((cdecl))
+main (void)
+{
+  if (leaf (1, 10, 100) != 2 + 30 + 500)
+    abort ();
+  if (sib (1, 10, 100) != 20 + 300 + 5)
+    abort ();
+  if (calli (leaf, 7) != 14 + 24 + 45)
+    abort ();
+  if (calli (sib, 7) != 16 + 27 + 35)
+    abort ();
+  return 0;
+}
diff --git a/gcc/testsuite/gcc.target/m68k/fastcall-sibcall.c b/gcc/testsuite/gcc.target/m68k/fastcall-sibcall.c
new file mode 100644
index 00000000000..1432855b05a
--- /dev/null
+++ b/gcc/testsuite/gcc.target/m68k/fastcall-sibcall.c
@@ -0,0 +1,45 @@
+/* { dg-do compile } */
+/* { dg-options "-m68000 -mfastcall -O2" } */
+
+extern long gfast (long, long, long) __attribute__((fastcall));
+extern long hfast (long, long, long) __attribute__((fastcall));
+extern long gstd (long, long, long) __attribute__((cdecl));
+
+typedef long (*fastfn) (long, long, long) __attribute__((fastcall));
+
+long __attribute__((fastcall, noipa))
+sib (long a, long b, long c)
+{
+  return gfast (a, b, c);
+}
+
+long __attribute__((fastcall, noipa))
+sibind (fastfn f, long a)
+{
+  return f (a, a, a);
+}
+
+long __attribute__((fastcall, noipa))
+tail_to_std (long a, long b, long c)
+{
+  return gstd (a, b, c);
+}
+
+long __attribute__((cdecl, noipa))
+std_to_fast (long a, long b, long c)
+{
+  return hfast (a, b, c);
+}
+
+/* Direct fastcall->fastcall tail call becomes a sibcall.  */
+/* { dg-final { scan-assembler {jra gfast} } } */
+
+/* The indirect fastcall tail call must stay a plain call.  */
+/* { dg-final { scan-assembler {jsr \(%a0\)} } } */
+/* { dg-final { scan-assembler-not {jra \(%a} } } */
+
+/* Cross-ABI tail calls must stay plain calls, both directions.  */
+/* { dg-final { scan-assembler {jsr gstd} } } */
+/* { dg-final { scan-assembler-not {jra gstd} } } */
+/* { dg-final { scan-assembler {jsr hfast} } } */
+/* { dg-final { scan-assembler-not {jra hfast} } } */
