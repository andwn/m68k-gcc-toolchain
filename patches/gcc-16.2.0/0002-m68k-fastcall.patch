diff --git a/gcc/testsuite/gcc.target/m68k/fastcall-cross-abi-run.c b/gcc/testsuite/gcc.target/m68k/fastcall-cross-abi-run.c
new file mode 100644
index 00000000000..2d0e8427c49
--- /dev/null
+++ b/gcc/testsuite/gcc.target/m68k/fastcall-cross-abi-run.c
@@ -0,0 +1,48 @@
+/* { dg-do run } */
+/* { dg-options "-m68000 -mfastcall -O2" } */
+
+/* Cross-ABI calls under -mfastcall: a cdecl callee called from a fastcall
+   caller and a fastcall callee called from a cdecl caller, with enough
+   arguments to cover d0-d2, a0 and the stack overflow slot.  */
+
+extern void abort (void);
+
+long __attribute__((cdecl, noipa))
+std_mix (long a, long b, long c, long d)
+{
+  return a + b * 3 + c * 5 + d * 7;
+}
+
+long __attribute__((fastcall, noipa))
+fast_mix (long a, long *p, long b, short c, long d)
+{
+  return a + *p * 3 + b * 5 + c * 7 + d * 11;
+}
+
+long __attribute__((fastcall, noipa))
+from_fast (long a, long b)
+{
+  return std_mix (a, b, a + b, a - b);
+}
+
+long __attribute__((cdecl, noipa))
+from_std (long a, long b)
+{
+  long v = 1000;
+  return fast_mix (a, &v, b, (short) (a - b), a + b);
+}
+
+int __attribute__((cdecl))
+main (void)
+{
+  if (std_mix (1, 2, 3, 4) != 1 + 6 + 15 + 28)
+    abort ();
+  long v = 40;
+  if (fast_mix (1, &v, 3, -4, 5) != 1 + 120 + 15 - 28 + 55)
+    abort ();
+  if (from_fast (10, 4) != 10 + 12 + 70 + 42)
+    abort ();
+  if (from_std (10, 4) != 10 + 3000 + 20 + 42 + 154)
+    abort ();
+  return 0;
+}
diff --git a/gcc/testsuite/gcc.target/m68k/fastcall-d2.c b/gcc/testsuite/gcc.target/m68k/fastcall-d2.c
