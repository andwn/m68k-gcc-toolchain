+/* { dg-final { scan-assembler {moveq #33,%d2} } } */
+
+/* load2's pointer args arrive in a0/a1 and are dereferenced directly.  */
+/* { dg-final { scan-assembler {\(%a0\)} } } */
+/* { dg-final { scan-assembler {\(%a1\)} } } */
+
+/* f4's fourth scalar arg does not fit d0-d2 and comes from the stack.  */
+/* { dg-final { scan-assembler {4\(%sp\)} } } */
diff --git a/gcc/testsuite/gcc.target/m68k/fastcall-cdecl-d2-run.c b/gcc/testsuite/gcc.target/m68k/fastcall-cdecl-d2-run.c
new file mode 100644
index 00000000000..fbecbabb13c
--- /dev/null
+++ b/gcc/testsuite/gcc.target/m68k/fastcall-cdecl-d2-run.c
@@ -0,0 +1,37 @@
+/* { dg-do run } */
+/* { dg-options "-m68000 -mfastcall -O2" } */
+
+/* A cdecl function compiled under -mfastcall must still preserve d2:
+   its callers were compiled without -mfastcall and rely on it.  */
+
+extern void abort (void);
+
+long sink[8];
+
+void __attribute__((noipa))
+touch (long *p)
+{
+  *p += 1;
+}
+
+/* Enough live values across a call to need d2 as well as d3-d7.  */
+long __attribute__((cdecl, noipa))
+callee (long a, long b, long c, long d, long e, long f)
+{
+  long x = a * 3, y = b * 5, z = c * 7, w = d * 11, v = e * 13, u = f * 17;
+  touch (&sink[0]);
+  sink[1] = x; sink[2] = y; sink[3] = z; sink[4] = w; sink[5] = v; sink[6] = u;
+  return x + y + z + w + v + u;
+}
+
+int __attribute__((cdecl))
+main (void)
+{
+  register long keep asm ("%d2") = 0x12345678;
+  __asm__ ("" : "+r" (keep));
+  callee (1, 2, 3, 4, 5, 6);
+  __asm__ ("" : "+r" (keep));
+  if (keep != 0x12345678)
+    abort ();
+  return 0;
+}
