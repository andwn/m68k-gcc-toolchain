 |
 SYM(memset):
 	move.l	4(sp),a0	| dest ptr
+#if __SIZEOF_INT__ == 2
+	move.w	8(sp),d0	| value (int is one word under -mshort)
+	move.l	10(sp),d1	| len (size_t is still a long)
+#else
